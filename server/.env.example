# ---------------------------------------------------------------------------
# SM Welfare API - environment template
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# MongoDB connection string - do not commit real credentials, use your own
MONGODB_URI=mongodb://127.0.0.1:27017/sm_welfare

# Security
# bcrypt work factor for password hashing (integer 4-16; invalid values fall back to 12)
BCRYPT_ROUNDS=12

# Authentication - JWT secrets and cookie policy (server-only, never committed)
# Generate real secrets with: openssl rand -hex 32
AUTH_ACCESS_TOKEN_SECRET=change-me-access-secret-at-least-32-chars-long
AUTH_REFRESH_TOKEN_SECRET=change-me-refresh-secret-at-least-32-chars-long
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# Initial SUPER_ADMIN provisioning (one-time, server-side CLI)
# ---------------------------------------------------------------------------
# Used only by: npm run provision:super-admin
# Not required by the API server itself. When omitted and stdin is a terminal
# the CLI prompts interactively (password echo is disabled); in non-interactive
# shells they must be set. Never pass credentials on the command line.
# SUPER_ADMIN_EMAIL=superadmin@example.com
# SUPER_ADMIN_PASSWORD=change-me-strong-password
# SUPER_ADMIN_NAME=Super Admin

# ---------------------------------------------------------------------------
# Cloudinary media uploads (server-only, never committed, never exposed to the
# client - do NOT prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Used by the /api/v1/media endpoints. In production the server refuses to boot
# without these; in development media endpoints fail with a clear error until
# they are set. Get them from the Cloudinary dashboard.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your-api-secret
