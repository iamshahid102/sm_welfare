# ---------------------------------------------------------------------------
# SM Welfare API - environment template
# Copy to .env and fill in real values. Never commit .env.# ---------------------------------------------------------------------------
# Application
# HOST and PORT are only used by the long-running server (npm run dev /
# npm start). Vercel runs the API as a serverless function instead
# (api/index.js) and ignores both.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# CORS - comma-separated list of allowed origins
# Vercel: https://sm-welfare.vercel.app
CORS_ORIGINS=http://localhost:3000

# MongoDB connection string - do not commit real credentials, use your own
MONGODB_URI=mongodb://127.0.0.1:27017/sm_welfare

# Security
# bcrypt work factor for password hashing (integer 4-16; invalid values fall back to 12)
BCRYPT_ROUNDS=12

# Authentication - JWT secrets and cookie policy (server-only, never committed)
# Generate real secrets with: openssl rand -hex 32
AUTH_ACCESS_TOKEN_SECRET=change-me-access-secret-at-least-32-chars-long
AUTH_REFRESH_TOKEN_SECRET=change-me-refresh-secret-at-least-32-chars-long
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
# Vercel (https://sm-welfare-api.vercel.app) cookie policy:
#   AUTH_COOKIE_SECURE=true
#   AUTH_COOKIE_SAMESITE=lax
# Browser requests reach this API through the client app's own origin (a
# Next.js rewrite), so the cookies are first-party and `lax` is both sufficient
# and safer than `none`. Use `none` only if you later call the API directly,
# cross-site, from the browser (it also requires AUTH_COOKIE_SECURE=true).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# One-time administrator provisioning (server-side CLI)
# ---------------------------------------------------------------------------
# Used only by: npm run provision:admin
# Creates the single admin account that operates the whole CMS. Not required
# by the API server itself. When omitted and stdin is a terminal the CLI
# prompts interactively (password echo is disabled); in non-interactive shells
# they must be set. Never pass credentials on the command line.
# The legacy names SUPER_ADMIN_EMAIL / SUPER_ADMIN_PASSWORD / SUPER_ADMIN_NAME
# are still read as fallbacks.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-strong-password
# ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# Cloudinary media uploads (server-only, never committed, never exposed to the
# client - do NOT prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Used by the /api/v1/media endpoints. In production the server refuses to boot
# without these; in development media endpoints fail with a clear error until
# they are set. Get them from the Cloudinary dashboard.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your-api-secret
